# Local-only defaults. Replace with secret-manager values outside development.
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Application database connection (MUST use unprivileged runtime role with NOBYPASSRLS/NOSUPERUSER)
DATABASE_URL=postgresql://moducraft_runtime:moducraft_runtime_local@127.0.0.1:5432/moducraft

# Administrative migration connection (Used exclusively by migration runners/CI, never by API runtime)
# MIGRATION_DATABASE_URL=postgresql://moducraft:<admin_password>@127.0.0.1:5432/moducraft

# Authentication Provider Configuration (OIDC / JWT)
# When unset, API fails closed and protected endpoints return 401 AUTH_NOT_CONFIGURED
# AUTH_ISSUER=https://identity.example.com/realms/moducraft
# AUTH_AUDIENCE=moducraft-api
# AUTH_JWKS_URI=https://identity.example.com/realms/moducraft/protocol/openid-connect/certs

# AI Provider Credentials Encryption Key (Phase 4B)
# 256-bit master key (64-char hex string). Used for AES-256-GCM encryption with tenant AAD binding.
# Fails closed if missing, invalid length, or corrupted. Must NEVER be stored in the database.
# In production, inject this from AWS Secrets Manager, GCP Secret Manager, or HashiCorp Vault.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

