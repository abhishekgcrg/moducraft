# ModuCraft Dedicated Test Environment Configuration (Template)
# Copy to .env.test for local test execution against dedicated database 'moducraft_test'.
# Under NO circumstances should DATABASE_URL or TEST_SUPERUSER_DATABASE_URL point to 'moducraft'.

NODE_ENV=test
API_PORT=4001
API_HOST=127.0.0.1

# Isolated Test Database (Strictly moducraft_test - NEVER moducraft)
DATABASE_URL=postgresql://moducraft_runtime:<RUNTIME_PASSWORD>@127.0.0.1:5432/moducraft_test
TEST_SUPERUSER_DATABASE_URL=postgresql://moducraft:<SUPERUSER_PASSWORD>@127.0.0.1:5432/moducraft_test

# Test Auth Configuration
AUTH_ISSUER=https://auth.moducraft.test
AUTH_AUDIENCE=moducraft-api
AUTH_SECRET=test-jwt-secret-key-at-least-32-chars-long!
